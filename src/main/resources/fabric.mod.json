{
	"schemaVersion": 1,
	"id": "village-extension",
	"version": "${version}",
	"name": "Village Extension",
	"description": "This mod includes many items for developing village.",
	"authors": [
		"fuyossi"
	],
	"contact": {
		"homepage": "https://github.com/fuyossi/village-extension-26.2",
		"sources": "https://github.com/fuyossi/village-extension-26.2"
	},
	"license": "MIT",
	"icon": "assets/village-extension/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.fuyossi.village_extension.VillageExtension"
		],
		"client": [
			"com.fuyossi.village_extension.client.VillageExtensionClient"
		]
	},
	"mixins": [
		"village-extension.mixins.json",
		{
			"config": "village-extension.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}